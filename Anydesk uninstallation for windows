# The script will uninstall all applications with "Anydesk" in their names

# Get a list of all installed applications
$installedApps = Get-WmiObject -Class Win32_Product | Where-Object { $_.Name -like '*AnyDesk*' }

# Loop through each installed application and uninstall it
foreach ($app in $installedApps) {
    Write-Host "Uninstalling $($app.Name)..."
    $app.Uninstall()
    Write-Host "Uninstalled $($app.Name)"
}
