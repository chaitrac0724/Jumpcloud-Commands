# Get device serial number
$DeviceSerialNumber = (Get-CimInstance Win32_BIOS).SerialNumber

# Get all physical disks
$disks = Get-PhysicalDisk

if ($disks) {

    $disks | Select-Object `
        @{Name='DeviceSerialNumber'; Expression={$DeviceSerialNumber}},
        @{Name='FriendlyName';       Expression={$_.FriendlyName}},
        @{Name='MediaType';          Expression={$_.MediaType}},
        @{Name='BusType';            Expression={$_.BusType}},
        @{Name='Size(GB)';           Expression={[math]::Round($_.Size / 1GB, 2)}},
        @{Name='Health';             Expression={$_.HealthStatus}} |
    Format-Table -AutoSize
}
else {
    Write-Output "No Physical Disks detected. (This might be a specialized VM driver)"
}
